{
  "name": "loom",
  "version": "0.0.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "loom",
      "version": "0.0.0",
      "workspaces": [
        "packages/*"
      ],
      "engines": {
        "node": ">=22.0.0"
      }
    },
    "node_modules/@loom/core": {
      "resolved": "packages/core",
      "link": true
    },
    "node_modules/@loom/search": {
      "resolved": "packages/search",
      "link": true
    },
    "node_modules/@loom/server": {
      "resolved": "packages/server",
      "link": true
    },
    "packages/core": {
      "name": "@loom/core",
      "version": "0.0.0"
    },
    "packages/search": {
      "name": "@loom/search",
      "version": "0.0.0"
    },
    "packages/server": {
      "name": "@loom/server",
      "version": "0.0.0"
    }
  }
}
